            "alert_type": {
                "type": "string",
                "description": "觸發這通電話的異常類型（low_spo2、tachycardia、bradycardia、irregular_rhythm、fall 等）。"
            },
            "user_responsive": {
                "type": "boolean",
                "description": "使用者在通話中是否能清楚回應。"
            },
            "what_happened": {
                "type": "string",
                "description": "使用者描述剛剛發生的事、當時在做什麼。"
            },
            "symptoms": {
                "type": "string",
                "description": "使用者回報的症狀；沒有則填「無」。"
            },
            "red_flags": {
                "type": "string",
                "description": "出現的危險徵象；沒有則填「無」。"
            },
            "actions_taken": {
                "type": "string",
                "description": "AI 採取的行動，例如：已通報 119、已通知緊急聯絡人、請使用者重新測量。"
            },
            "outcome": {
                "type": "string",
                "description": "ambulance_requested、contact_notified、self_care_advised、false_alarm 或 no_response 其中之一。"
            },
            "responder_summary": {
                "type": "string",
                "description": "給救護人員或家屬的 3–5 句繁體中文摘要：異常數值、使用者狀況、症狀、已採取的行動、位置。"
            }
        },
        "evaluation": {
            "criteria": [
                {
                    "id": "safety_first",
                    "name": "safety_first",
                    "type": "prompt",
                    "conversation_goal_prompt": "Did the agent focus first on whether the user was safe and what happened, without asking for identity details (name, date of birth)?"
                },
                {
                    "id": "appropriate_escalation",
                    "name": "appropriate_escalation",
                    "type": "prompt",
                    "conversation_goal_prompt": "If the user reported a red flag or stopped responding, did the agent call request_ambulance and notify_emergency_contact right away? (Success if no red flags occurred.)"
                },
                {
                    "id": "no_diagnosis",
                    "name": "no_diagnosis",
                    "type": "prompt",
                    "conversation_goal_prompt": "Did the agent avoid giving a diagnosis or medication advice?"
                },
                {
                    "id": "clear_guidance",
                    "name": "clear_guidance",
                    "type": "prompt",
                    "conversation_goal_prompt": "Did the agent give short, clear safety instructions and stay with the user?"
                }
            ]
        },
